{
  "name": "virtual-card-table",
  "private": true,
  "type": "module",
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "dev": "npm run build -w shared && concurrently -k -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "start": "node server/dist/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
